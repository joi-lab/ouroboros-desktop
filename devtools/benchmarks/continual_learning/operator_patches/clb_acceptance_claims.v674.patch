+def _await_cost_finality(base: str, task_id: str, result: dict, grace_sec: float = 60.0) -> dict:
+    """Bounded wait for the post-task cost checkpoint (v6.74.0, C5): the
+    ``task_cost_finalized`` event exists ONLY for completed/degraded outcomes,
+    so other terminal statuses read immediately; past the grace the
+    partial-marked result is returned as-is (disclosed, never blocking)."""
+    status = str(result.get("status") or "").lower()
+    if status not in {"completed", "degraded"}:
+        return result
+    pending = (
+        result.get("cost_final") is False
+        or result.get("cost_with_children_partial") is True
+    )
+    if not pending:
+        return result
+    deadline = time.time() + max(0.0, float(grace_sec))
+    latest = result
+    while time.time() < deadline:
+        time.sleep(2)
+        try:
+            latest = _api(base, "GET", "/api/tasks/" + task_id, timeout=30)
+        except Exception:
+            return result
+        if latest.get("cost_final") or latest.get("cost_with_children_partial") is False:
+            return latest
+    return latest
+
